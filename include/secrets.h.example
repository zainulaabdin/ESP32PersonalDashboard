// Copy this file to secrets.h and fill in real values. secrets.h itself is
// gitignored - never commit real credentials.
// Fallback Wi-Fi, used only until a network is set up via SoftAP provisioning
// (Settings -> Wi-Fi icon). Leave both empty to go straight to the
// provisioning QR screen on a fresh board.
static const char *WIFI_DEFAULT_SSID = "";
static const char *WIFI_DEFAULT_PASSWORD = "";

static const char *LTA_API_KEY = "YOUR_LTA_DATAMALL_API_KEY";
// Default favourite bus stop (both morning and afternoon) until set on
// the web settings page.
static const char *FAVORITE_BUS_STOP = "43239";

// Outlook's "Publish a calendar" ICS feed URL (plain HTTPS GET, no OAuth).
static const char *OUTLOOK_ICS_URL = "YOUR_OUTLOOK_ICS_URL";

// ask.cpp checks for this exact placeholder string and shows a clear
// "no API key set" error instead of sending it and getting a 401.
static const char *OPENAI_API_KEY = "SET_ME_OPENAI_API_KEY";

// OTA (ota.cpp): fine-grained GitHub token with read-only "Contents" access to
// zainulaabdin/ESP32PersonalDashboard only. Empty = OTA checks are skipped.
static const char *GITHUB_OTA_TOKEN = "";

// Web settings page login (user "admin").
#define WEB_CONFIG_PASSWORD "changeme"
